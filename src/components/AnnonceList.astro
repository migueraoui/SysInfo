---
import { render, type CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate } from '../lib/format';

interface Props {
  annonces: CollectionEntry<'annonces'>[];
}

const { annonces } = Astro.props;
const rendered = await Promise.all(annonces.map(async (a) => ({ a, Content: (await render(a)).Content })));
---

<ul class="annonces" role="list">
  {
    rendered.map(({ a, Content }) => (
      <li class="annonce">
        <span class="annonce__icon">
          <Icon name="megaphone" size={20} />
        </span>
        <div class="annonce__body">
          <h3 class="annonce__title">{a.data.titre}</h3>
          <p class="annonce__date">
            <time datetime={a.data.date}>{formatDate(a.data.date)}</time>
          </p>
          <div class="annonce__text">
            <Content />
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .annonces {
    display: grid;
    gap: 0.75rem;
  }
  .annonce {
    display: flex;
    gap: 0.875rem;
    padding: 1rem 1.125rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .annonce__icon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--badge-td-bg);
    color: var(--badge-td-fg);
  }
  .annonce__body {
    min-width: 0;
  }
  .annonce__title {
    font-size: 1rem;
  }
  .annonce__date {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .annonce__text {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
  }
  .annonce__text :global(p + p) {
    margin-top: 0.5em;
  }
</style>
