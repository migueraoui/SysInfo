---
import Icon from './Icon.astro';
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Thème sombre" aria-pressed="false">
  <Icon name="moon" size={20} class="theme-toggle__moon" />
  <Icon name="sun" size={20} class="theme-toggle__sun" />
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--heading);
    cursor: pointer;
    transition: background-color 0.15s var(--ease);
  }
  .theme-toggle:hover {
    background: var(--surface-hover);
  }
  .theme-toggle :global(.icon) {
    grid-area: 1 / 1;
  }
  /* Thème clair : on montre la lune (passer en sombre). Thème sombre : le soleil. */
  .theme-toggle :global(.theme-toggle__sun) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.theme-toggle__sun) {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.theme-toggle__moon) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.theme-toggle__sun) {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.theme-toggle__moon) {
      display: none;
    }
  }
</style>
