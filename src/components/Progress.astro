---
import type { SeanceSummary } from '../lib/types';

interface Props {
  seances: SeanceSummary[];
}

const { seances } = Astro.props;
const total = seances.length;
const publiees = seances.filter((s) => s.publiee).length;
const pct = total ? Math.round((publiees / total) * 100) : 0;
---

<div class="progress">
  <p class="progress__label">
    <strong>{publiees}</strong>
    {publiees > 1 ? 'séances publiées' : 'séance publiée'} sur {total}
  </p>
  <div
    class="progress__bar"
    role="progressbar"
    aria-label="Séances publiées"
    aria-valuemin="0"
    aria-valuemax={total}
    aria-valuenow={publiees}
    aria-valuetext={`${publiees} sur ${total}`}
  >
    <span style={`width:${pct}%`}></span>
  </div>
  <ol class="progress__steps" role="list">
    {
      seances.map((s) => (
        <li class:list={[s.publiee && 'is-done']}>
          <a href={s.href} aria-label={`Séance ${s.numero}${s.publiee ? ' (publiée)' : ' (à venir)'}`}>
            {s.numero}
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .progress {
    display: grid;
    gap: 0.625rem;
  }
  .progress__label {
    font-size: 0.9375rem;
  }
  .progress__label strong {
    font-size: 1.25rem;
  }
  .progress__bar {
    height: 0.5rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.2);
    overflow: hidden;
  }
  .progress__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }
  .progress__steps {
    display: flex;
    gap: 0.375rem;
  }
  .progress__steps a {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.625rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    color: #ffffff;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: background-color 0.15s var(--ease);
  }
  .progress__steps a:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .progress__steps .is-done a {
    background: var(--accent);
    border-color: var(--accent);
    color: #1b2433;
  }
  .progress__steps a:focus-visible {
    outline-color: #f2bb6d;
  }
</style>
