---
import Icon from './Icon.astro';

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Fil d'Ariane">
  <ol role="list">
    {
      items.map((item, i) => (
        <li>
          {i > 0 && <Icon name="chevron-right" size={14} />}
          {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-muted);
  }
  .breadcrumb a:hover {
    color: var(--link);
  }
  .breadcrumb [aria-current] {
    color: var(--text);
    font-weight: 500;
  }
</style>
