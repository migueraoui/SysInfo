---
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import type { SeanceSummary } from '../lib/types';
import { pad2 } from '../lib/format';

interface Props {
  seance: SeanceSummary;
  headingLevel?: 2 | 3;
}

const { seance, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const labels = { cours: 'Cours', td: 'TD', corrige: 'Corrigé' } as const;
---

<article class:list={['seance-card', !seance.publiee && 'seance-card--soon']} data-chapitre={seance.chapitre}>
  <div class="seance-card__top">
    <span class="seance-card__num" aria-hidden="true">{pad2(seance.numero)}</span>
    <span class="seance-card__chap">Séance {seance.numero} · Chapitre {seance.chapitre}</span>
  </div>
  <Heading class="seance-card__title">
    <a href={seance.href} class="seance-card__link">{seance.titre}</a>
  </Heading>
  {seance.resume && <p class="seance-card__resume">{seance.resume}</p>}
  <div class="seance-card__foot">
    {
      seance.publiee ? (
        <ul class="seance-card__badges" role="list" aria-label="Documents disponibles">
          {seance.documents.map((d) => (
            <li>
              <Badge variant={d.type}>{labels[d.type]}</Badge>
            </li>
          ))}
        </ul>
      ) : (
        <Badge variant="soon">À venir</Badge>
      )
    }
    <Icon name="arrow-right" size={18} class="seance-card__arrow" />
  </div>
</article>

<style>
  .seance-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.125rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  @media (min-width: 48rem) {
    .seance-card {
      padding: 1.375rem;
    }
  }
  .seance-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .seance-card:focus-within {
    border-color: var(--border-strong);
  }
  .seance-card--soon {
    background: var(--surface-2);
    box-shadow: none;
  }
  .seance-card__top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .seance-card__num {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .seance-card--soon .seance-card__num {
    background: var(--badge-soon-bg);
    color: var(--badge-soon-fg);
  }
  .seance-card__chap {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .seance-card__title {
    font-size: 1.0625rem;
    line-height: 1.35;
  }
  .seance-card__link {
    color: inherit;
    text-decoration: none;
  }
  .seance-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .seance-card__link:focus-visible {
    outline: none;
  }
  .seance-card__link:focus-visible::after {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .seance-card:hover .seance-card__link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .seance-card__resume {
    font-size: 0.9375rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .seance-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .seance-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .seance-card__foot :global(.seance-card__arrow) {
    color: var(--text-muted);
    transition: transform 0.2s var(--ease);
  }
  .seance-card:hover :global(.seance-card__arrow) {
    transform: translateX(3px);
    color: var(--link);
  }
</style>
