---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocumentList from '../../components/DocumentList.astro';
import { getAllDocuments, getChapitres } from '../../lib/content';
import { MODULE } from '../../site.config';

const docs = await getAllDocuments('cours');
const chapitres = await getChapitres();
---

<BaseLayout
  title="Cours"
  description={`Tous les cours publiés du module ${MODULE.nom} (${MODULE.niveauCourt}, ${MODULE.semestre}), à lire en ligne ou à télécharger en PDF.`}
>
  <header class="container page-head">
    <p class="eyebrow">{MODULE.nom}</p>
    <h1>Cours</h1>
    <p class="lead">Les supports de cours publiés, du plus récent au plus ancien.</p>
  </header>
  <section class="container section" aria-label="Liste des cours">
    <DocumentList
      docs={docs}
      chapitres={chapitres}
      noun={['cours', 'cours']}
      emptyMessage="Aucun cours n'est encore publié."
    />
  </section>
</BaseLayout>
